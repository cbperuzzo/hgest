# Copy to .env (git-ignored) and fill in. Read automatically by `docker compose`.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# at least 32 characters
JWT_SECRET=change_me_to_a_random_string_of_at_least_32_chars
# access token lifetime in ms (4h)
JWT_EXPIRATION=14400000

# initial DEV user, only created when the user table is empty
HGEST_BOOTSTRAP_USERNAME=admin
HGEST_BOOTSTRAP_PASSWORD=change_me_too

# comma-separated browser origins allowed to call the API; leave empty for the native app only
HGEST_CORS_ALLOWED_ORIGINS=
